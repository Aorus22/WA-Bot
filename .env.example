PORT=:3090
LOG_LEVEL=ERROR
ADMIN_GROUPS_JID=
API_SECRET=

# Optional infra (default jika kosong)
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CALL_RING_TIMEOUT_SECONDS=45
LIGHTPANDA_CDP_URL=http://lightpanda:9222
#CHROME_BIN=

# Call TTS & AI (GEMINI_API_KEY, AI_SERVER_URL, CALL_TTS_*) dikelola via
# halaman Settings (/settings) di DB — jangan set via env lagi.

# Object storage (media). Default: one SQLite file per WhatsApp account, no extra
# service. {account} is replaced by the phone number; a path without it uses one
# shared file. Back up with:
#   wa-bot-backend storage backup --output <dir>
OBJECT_STORAGE_DRIVER=sqlite
OBJECT_STORAGE_BUCKET=wa-bot
OBJECT_STORAGE_SQLITE_PATH=./accounts/{account}/database/objectstorage.sqlite
# Scratch folder for ffmpeg / yt-dlp / Lua (disposable, wiped at start)
#OBJECT_STORAGE_STAGING_DIR=./tmp/staging

# Driver "s3": AWS S3 / Cloudflare R2 / MinIO / any S3-compatible service.
# Changing the driver does NOT move existing media; use
#   wa-bot-backend storage copy --from sqlite --to s3
#S3_ENDPOINT=
#S3_REGION=ap-southeast-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_BUCKET=wa-bot
#S3_FORCE_PATH_STYLE=true

# Optional S3 endpoint for the sqlite driver (AWS CLI/SDK access to the media).
# Loopback only; every request must be SigV4-signed with this key.
# Keys look like accounts/<phone>/media/<key>.
S3_GATEWAY_ENABLED=false
S3_GATEWAY_BIND=127.0.0.1:9000
#S3_GATEWAY_ACCESS_KEY_ID=
#S3_GATEWAY_SECRET_ACCESS_KEY=
